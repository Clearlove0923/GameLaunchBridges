<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Calabiyau.LaunchBridge</RootNamespace>
    <AssemblyName>CalabiyauLaunchBridge</AssemblyName>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>CalabiyauLaunchBridge</Product>
    <Description>Launches Calabiyau through its official launcher and keeps Steam's Playing state active while the game is running.</Description>
    <ApplicationIcon Condition="Exists('Calabiyau.ico')">Calabiyau.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
